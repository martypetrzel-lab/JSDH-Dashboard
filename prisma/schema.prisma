generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum PrimaryRole {
  UNIT_COMMANDER
  SQUAD_COMMANDER
  DRIVER
  FIREFIGHTER
  UNASSIGNED
}

enum AssignmentRole {
  COMMANDER
  DRIVER
  FIREFIGHTER
}

enum ServiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SelectionMode {
  AUTO
  MANUAL
}

model Member {
  id                String                    @id @default(cuid())
  firstName         String
  lastName          String
  birthDate         DateTime?                 @db.Date
  primaryRole       PrimaryRole               @default(UNASSIGNED)
  medicalExamAt     DateTime?                 @db.Date
  medicalValidUntil DateTime?                 @db.Date
  active            Boolean                   @default(true)
  reserveOnly       Boolean                   @default(false)
  systemAccount     Boolean                   @default(false)
  dt                Boolean                   @default(false)
  canCommand        Boolean                   @default(false)
  canDrive          Boolean                   @default(false)
  canFight          Boolean                   @default(true)
  note              String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  unavailability    Unavailability[]
  assignments       WeeklyServiceAssignment[]

  @@index([active])
  @@index([lastName, firstName])
}

model Unavailability {
  id        String   @id @default(cuid())
  memberId  String
  from      DateTime
  to        DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, from, to])
}

model WeeklyService {
  id          String                    @id @default(cuid())
  weekStart   DateTime                  @unique
  weekEnd     DateTime
  status      ServiceStatus             @default(DRAFT)
  confirmedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  assignments WeeklyServiceAssignment[]

  @@index([status, weekStart])
}

model WeeklyServiceAssignment {
  id            String         @id @default(cuid())
  serviceId     String
  memberId      String
  role          AssignmentRole
  slot          Int            @default(1)
  selectionMode SelectionMode
  nameSnapshot  String
  roleSnapshot  String
  dtSnapshot    Boolean
  createdAt     DateTime       @default(now())
  service       WeeklyService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  member        Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([serviceId, role, slot])
  @@unique([serviceId, memberId])
  @@index([memberId])
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  action      String
  entity      String
  entityId    String
  description String
  actor       String

  @@index([timestamp])
  @@index([entity, entityId])
}

model Settings {
  id               String   @id @default("default")
  weekStartDay     Int      @default(1)
  weekStartHour    Int      @default(6)
  weekEndDay       Int      @default(0)
  weekEndHour      Int      @default(6)
  fairDraw         Boolean  @default(true)
  considerTotal    Boolean  @default(true)
  considerRole     Boolean  @default(true)
  preferRested     Boolean  @default(true)
  allowConsecutive Boolean  @default(true)
  minimumDt        Int      @default(1)
  timezone         String   @default("Europe/Prague")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AdminSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  username   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

model LoginAttempt {
  key         String   @id
  attempts    Int      @default(0)
  windowStart DateTime @default(now())
  blockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

model MedicalTemplate {
  id          String   @id @default("current")
  filename    String
  contentType String
  data        Bytes
  size        Int
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
